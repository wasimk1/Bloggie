@model Bloggie.Web.Models.ViewModels.EditTagRequest

@{
    ViewData["Title"] = "Edit Tags";
}

<div class="page-banner">
    <div class="container">
        <div><span class="eyebrow">YOUR WORKSPACE</span><h1>Edit tag</h1><p>Make every detail count.</p></div>
    </div>
</div>


    <div class="container admin-content">
        @if (Model != null)
        {
            <form method="post" class="form-surface"><div asp-validation-summary="ModelOnly" role="alert"></div>
                <div class="mb-3">
                    <label class="form-label" for="Id">Id</label>
                    <input type="text" class="form-control" asp-for="Id" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="Name">Name</label>
                    <input type="text" class="form-control" asp-for="Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="DisplayName">Display Name</label>
                    <input type="text" class="form-control" asp-for="DisplayName" />
                </div>
                <div class="mb-3">
                    <div class="d-flex">
                        <button type="submit" class="btn btn-primary">Update Tag</button>

                        <button type="submit" class="btn btn-danger" asp-controller="AdminTags"
                                asp-action="Delete" asp-route-Id="@Model.Id">
                            Delete
                        </button>
                    </div>
                </div>
            </form>
        }
        else
        {
            <div class="empty-state"><h3>Tag not found</h3><p>This topic is no longer available.</p><a class="btn btn-primary" asp-controller="AdminTags" asp-action="List">Back to tags</a></div>
        }
    </div>

