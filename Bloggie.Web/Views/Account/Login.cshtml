@model Bloggie.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Welcome back";
}
<div class="container">
    <div class="auth-shell">
        <aside class="auth-story">
            <span class="eyebrow">A HOME FOR CURIOUS MINDS</span>
            <h2>Ideas are better<br />when we share them.</h2>
            <p>Explore the world of development, find your next inspiration, and be part of the conversation.</p>
            <span class="auth-art" aria-hidden="true">✳</span>
        </aside>
        <section class="auth-form">
            <span class="eyebrow">GOOD TO SEE YOU AGAIN</span>
            <h1>Welcome back.</h1>
            <p>Login to pick up where you left off.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" role="alert"></div>
                <div class="mb-3">
                    <label class="form-label" for="username">Username</label>
                    <input type="text" id="username" class="form-control" asp-for="Username" autocomplete="username" placeholder="Your username" required />
                    <span class="text-danger" asp-validation-for="Username"></span>
                </div>
                
                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <input type="password" id="password" class="form-control" asp-for="Password" autocomplete="current-password" required  />
                    <span class="text-danger" asp-validation-for="Password"></span>
                    
                </div>
                <div class="mt-4"><button type="submit" class="btn btn-primary" asp-action="Login" asp-controller="Account">Login <span aria-hidden="true">↗</span></button></div>
                <input type="hidden" class="form-control" asp-for="ReturnUrl" />
            </form>
            <div class="auth-switch">New around here? <a asp-controller="Account" asp-action="Register">Create an account</a></div>
        </section>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
