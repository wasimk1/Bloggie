@model Bloggie.Web.Models.ViewModels.AddBlogPostRequest
@{

    ViewData["Title"] = "Add Blog Post";
}

    <div class="page-banner">
        <div class="container">
            <div><span class="eyebrow">YOUR WORKSPACE</span><h1>Write a new story</h1><p>Make every detail count.</p></div>
        </div>
    </div>
    <div class="container admin-content">
        <form method="post" class="form-surface"><div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="mb-3">
                <label class="form-label" for="heading">Heading</label>
                <input class="form-control" type="text" asp-for="Heading" id="heading" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="pageTitle">Page Title</label>
                <input class="form-control" type="text" asp-for="PageTitle" id="pageTitle" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="content">Content</label>
                <textarea class="form-control" asp-for="Content" id="content"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label" for="shortDescription">Short Description</label>
                <input class="form-control" type="text" asp-for="ShortDescription" id="shortDescription" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="featuredImageUpload">Featured Image Upload</label>
                <input class="form-control" type="file" id="featuredImageUpload" aria-describedby="uploadStatus" /><div id="uploadStatus" class="form-text" role="status"></div>
                <img src="" width="300px" style="display:none;" id="featuredImageDisplay" alt="Featured image preview" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="featuredImageUrl">Featured Image Url</label>
                <input class="form-control" type="text" asp-for="FeaturedImageUrl" id="featuredImageUrl" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label" for="urlHandle">URL handle</label>
                <input class="form-control" type="text" asp-for="UrlHandle" id="urlHandle" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="publishDate">Publish Date</label>
                <input class="form-control" type="date" asp-for="PublishDate" id="publishDate" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="author">Author</label>
                <input class="form-control" type="text" asp-for="Author" id="author" />
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="Visible" asp-for="Visible">
                <label class="form-check-label" for="Visible"> Visible to readers </label>
            </div>

            <div class="mb-3">
                <label class="form-label" for="SelectedTags">Tags</label>
                <select aria-describedby="tags-help" class="form-select" asp-items="@Model.Tags" asp-for="SelectedTags">
                </select><div class="form-text" id="tags-help">Choose one or more topics. Hold Ctrl on Windows or Command on Mac to select multiple tags.</div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save Blog Post</button>
            </div>

        </form>
    </div>

    @section Scripts { <partial name="_BlogEditorScripts" /> }