@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> signInManger
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fff4d6" />
    <title>@ViewData["Title"] · Bloggie</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/froala-editor@latest/css/froala_editor.pkgd.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(currentController?.StartsWith("Admin") == true ? "admin-page" : "")">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">b.</span>bloggie<span class="brand-dot">.</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav mx-lg-auto">
                        <li class="nav-item"><a class="nav-link @(currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="stories">Explore stories</a></li>
                        @if (signInManger.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(currentController?.StartsWith("Admin") == true ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Manage</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="AdminTags" asp-action="Add">Add tag</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="AdminTags" asp-action="List">All tags</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="AdminBlogPosts" asp-action="Add">Write a post</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="AdminBlogPosts" asp-action="List">All blog posts</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="AdminUsers" asp-action="List">Users</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <div class="nav-account">
                        @if (signInManger.IsSignedIn(User))
                        {
                            <span class="account-name">Hello, @User?.Identity?.Name</span>
                            <a class="btn btn-outline-dark" asp-area="" asp-controller="Account" asp-action="Logout">Logout</a>
                        }
                        else
                        {
                            <a class="btn btn-link" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Register">Join Bloggie <span aria-hidden="true">↗</span></a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" tabindex="-1">@RenderBody()</main>
    <footer class="site-footer">
        <div class="container footer-content">
            <div><a class="footer-brand" asp-area="" asp-controller="Home" asp-action="Index">bloggie<span class="brand-dot">.</span></a><p>A little curiosity. A lot to discover.</p></div>
            <div class="footer-links"><a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="stories">Explore stories</a><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a><span>&copy; @DateTime.Now.Year Bloggie</span></div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
